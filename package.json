{
  "name": "dsh-perf-guard",
  "version": "1.0.3",
  "description": "DSH 长会话优化插件：贴底跟随、思考链自动展开、截断/传输失败自动重试、待办常驻面板、离屏渲染降载。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "performance",
    "transcript",
    "scroll",
    "todo",
    "retry"
  ],
  "license": "MIT",
  "author": "TaoLe-si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaoLe-si/dsh-perf-guard.git"
  },
  "homepage": "https://github.com/TaoLe-si/dsh-perf-guard#readme",
  "bugs": {
    "url": "https://github.com/TaoLe-si/dsh-perf-guard/issues"
  },
  "scripts": {
    "test": "node --test test/host-smoke.mjs test/follow-sim.mjs && node test/client-smoke.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.4"
  },
  "dsh": {
    "displayName": "性能守卫",
    "description": "长会话滚动降载、贴底跟随、截断重试、待办常驻",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
