{
  "name": "dsh-perf-guard",
  "version": "0.5.0",
  "description": "DSH 性能守卫：长会话滚动降载、思考链自动展开、贴底跟随与宿主内存诊断。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "performance",
    "transcript",
    "scroll"
  ],
  "license": "MIT",
  "author": "TaoLe-si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaoLe-si/dsh-perf-guard.git"
  },
  "homepage": "https://github.com/TaoLe-si/dsh-perf-guard#readme",
  "bugs": {
    "url": "https://github.com/TaoLe-si/dsh-perf-guard/issues"
  },
  "scripts": {
    "test": "node --test test/host-smoke.mjs && node test/client-smoke.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "displayName": "性能守卫",
    "description": "长会话滚动降载、思考链自动展开、贴底跟随",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
