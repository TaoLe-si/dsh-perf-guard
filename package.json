{
  "name": "dsh-perf-guard",
  "version": "1.9.5",
  "description": "DSH 长会话优化插件：原生滚动兼容、模型目录、有限重试与可选冷会话缓存配置。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "model-catalog.js",
    "client.js",
    "cordis.patch.yml",
    "session-cache.patch.yml",
    "assets/",
    "icon.svg",
    "locale/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "performance",
    "transcript",
    "scroll",
    "retry"
  ],
  "license": "MIT",
  "author": "TaoLe-si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaoLe-si/dsh-perf-guard.git"
  },
  "homepage": "https://github.com/TaoLe-si/dsh-perf-guard#readme",
  "bugs": {
    "url": "https://github.com/TaoLe-si/dsh-perf-guard/issues"
  },
  "scripts": {
    "test": "node --test test/host-smoke.mjs test/host-contract.mjs test/model-catalog.mjs test/follow-sim.mjs test/hover-intent.mjs && node test/client-smoke.mjs",
    "check": "node --check index.js && node --check model-catalog.js && node --check client.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.4 || >=0.2.2-rc.1"
  },
  "dsh": {
    "displayName": "性能守卫",
    "description": "长会话渲染降载、原生滚动兼容、有限重试与本地诊断",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
